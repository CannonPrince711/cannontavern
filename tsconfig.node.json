{
  "extends": "./tsconfig.base.json",
  "include": [
    "electron.vite.config.ts",
    "vitest.config.ts",
    "src/main/**/*",
    "src/preload/**/*",
    "src/shared/**/*",
    "tests/**/*"
  ],
  "compilerOptions": {
    "lib": ["ES2023"],
    "types": ["node", "electron-vite/node"],
    "tsBuildInfoFile": "node_modules/.cache/tsbuildinfo.node.json"
  }
}
