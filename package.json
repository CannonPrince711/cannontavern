{
  "name": "dnd-tavern",
  "productName": "DND Tavern",
  "version": "0.2.13",
  "description": "A SillyTavern-style D&D chat frontend that stores everything in an Obsidian vault.",
  "main": "./out/main/index.js",
  "author": "DND Tavern",
  "homepage": "https://github.com/CannonPrince711/cannontavern",
  "desktopName": "dnd-tavern.desktop",
  "license": "MIT",
  "private": true,
  "scripts": {
    "dev": "electron-vite dev",
    "build": "npm run typecheck && electron-vite build",
    "typecheck": "tsc --noEmit -p tsconfig.node.json && tsc --noEmit -p tsconfig.web.json",
    "test": "vitest run",
    "test:watch": "vitest",
    "icon": "node scripts/make-icon.mjs",
    "dist": "npm run build && electron-builder --win --publish never",
    "dist:dir": "npm run build && electron-builder --win --dir",
    "release": "npm run build && node scripts/ensure-release.mjs && electron-builder --win --publish always",
    "dist:linux": "npm run build && electron-builder --linux --publish never",
    "release:linux": "npm run build && node scripts/ensure-release.mjs && electron-builder --linux --publish always"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^0.133.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@fontsource/cinzel": "^5.3.0",
    "@fontsource/eb-garamond": "^5.3.0",
    "@radix-ui/react-dialog": "^1.2.0",
    "@radix-ui/react-dropdown-menu": "^2.1.25",
    "@radix-ui/react-slot": "^1.4.0",
    "@radix-ui/react-tabs": "^1.1.22",
    "@radix-ui/react-tooltip": "^1.3.0",
    "@tailwindcss/vite": "^4.3.3",
    "@types/node": "^24.19.2",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.18.2",
    "@vitejs/plugin-react": "^5.2.0",
    "chokidar": "^5.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "electron-updater": "6.8.9",
    "electron-vite": "^5.0.0",
    "fetch-socks": "^1.3.3",
    "framer-motion": "^14.1.0",
    "jsonrepair": "3.15.0",
    "lucide-react": "^1.55.0",
    "png-to-ico": "^3.0.2",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "react-resizable-panels": "^4.14.4",
    "remark-gfm": "^4.0.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.7.0",
    "tailwindcss": "^4.3.3",
    "three": "^0.186.1",
    "tw-animate-css": "^1.4.0",
    "typescript": "5.9",
    "undici": "^8.11.2",
    "vite": "^7.3.7",
    "vitest": "^4.1.11",
    "ws": "^8.22.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.5",
    "zustand": "^5.0.15"
  },
  "allowScripts": {
    "esbuild@0.25.12": true,
    "esbuild@0.28.2": true,
    "electron-winstaller": false
  }
}
